{
  "expo": {
    "name": "EconoFlow",
    "slug": "econoflow-mobile",
    "owner": "econoflow",
    "scheme": "econoflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-512x512.png",
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "pt.econoflow.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-512x512.png",
        "backgroundColor": "#0f76a8"
      }
    },
    "ios": {
      "bundleIdentifier": "pt.econoflow.mobile",
      "buildNumber": "2"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061e33",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 150
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "econoflow",
          "project": "econoflow"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "EconoFlow uses your photo library so you can attach payslips and receipts.",
          "cameraPermission": "EconoFlow uses the camera so you can photograph payslips and receipts."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2265ef61-8266-496c-b5ff-3171b3078e88"
      }
    }
  }
}

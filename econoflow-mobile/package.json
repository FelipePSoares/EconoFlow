{
  "name": "econoflow-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "econoflow-log": "file:./modules/econoflow-log",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.33.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "~19.3.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.11",
    "jwt-decode": "^4.0.0",
    "react": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.3",
    "react-native-qrcode-svg": "^6.3.48",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zustand": "^5.0.16"
  },
  "publishConfig": {
    "executableFiles": [
      "./android/gradlew"
    ]
  },
  "overrides": {
    "@expo/ngrok": {
      "uuid": "14.0.3"
    },
    "@xmldom/xmldom@0.8": "0.8.15",
    "zod@4": "4.6.7",
    "@xmldom/xmldom@0.9": "0.9.12",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "compression": "1.8.2",
    "follow-redirects": "1.16.2",
    "http-cache-semantics": "4.3.0",
    "image-size": "2.0.4",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici@6": "6.29.1",
    "xcode": {
      "uuid": "14.0.3"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ App.tsx --ext .ts,.tsx --max-warnings 0",
    "e2e:build": "detox build -c android.emu.debug",
    "e2e:test": "detox test -c android.emu.debug",
    "prepare": "cd .. && git config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "bash -c 'cd .. && cd econoflow-mobile && tsc --noEmit'"
    ],
    "App.tsx": [
      "eslint --max-warnings 0"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|@sentry/.*|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "@react-native-async-storage/async-storage": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "/queryClient$": "<rootDir>/src/api/__mocks__/queryClient"
    }
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "detox": "^20.51.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^17.6.0",
    "test-renderer": "^1.3.1"
  }
}


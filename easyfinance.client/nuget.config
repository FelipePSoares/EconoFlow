<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept as a file because NuGet looks for it and tools have historically expected it,
  but it must NOT <clear /> the root sources: a nuget.config closer to a project
  replaces the source list for that whole subtree, which dropped both the private
  fps-software feed and the root <packageSourceMapping>. Everything that matters
  (sources, packageSourceMapping, credentials) comes from the root nuget.config.

  This directory holds the SPA esproj, which .NET restores when
  BuildingInsideVisualStudio or IncludeSpaProject=true, and the Docker build copies
  it. With the <clear /> gone, a public package restores here exactly as it does
  everywhere else, and a private one still resolves from Gitea.
-->
<configuration>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>

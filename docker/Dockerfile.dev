# EconoFlow — the Development image docker-compose.dev.yml runs.
#
# The release image (../Dockerfile) is Production-only: it refuses to start without SMTP
# credentials and a JWT secret, and it never seeds the sample data. Locally we need the
# opposite - a Development application serving the same browser bundle - so this image is the
# release image with the two differences below and nothing else. Both are marked DEV-ONLY:
#
#   1. `ASPNETCORE_ENVIRONMENT=Development`, the Development-only listen ports, and a
#      Development-only health probe.
#   2. `DefineConstants=DEBUG` on the publish.
#
# Everything else - the restore, the publish configuration, the Alpine runtime, and the fact
# that ONE process serves the SPA and the API - is identical to the release image. It used to
# carry a copy of the old two-process layout, which is how it drifted: the nginx site, the port
# scheme and the health probes each had two definitions.
#
# Docker cannot share stages across Dockerfiles (only another image's final stage can be
# imported), so the stages are repeated. ContainerSpaServingTests and DevStackTests fail if
# either image starts describing a layout the other one does not.
#
# ── Stage: client ───────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS client
WORKDIR /src

ARG NODE_MAJOR=22
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm --version && node --version

COPY easyfinance.client/package.json easyfinance.client/package-lock.json easyfinance.client/scripts/ ./easyfinance.client/
WORKDIR /src/easyfinance.client
RUN npm ci

COPY easyfinance.client/ ./

# The same command as the release image: one bundle, both stacks.
RUN npx ng build --configuration production

# ── Stage: api ──────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api
WORKDIR /src

ARG RUNTIME_ID=linux-x64

ARG GITEA_NUGET_USERNAME
ARG GITEA_NUGET_TOKEN
ENV GITEA_NUGET_USERNAME=${GITEA_NUGET_USERNAME} \
    GITEA_NUGET_TOKEN=${GITEA_NUGET_TOKEN}

COPY Directory.Build.props Directory.Build.targets global.json nuget.config ./
COPY EasyFinance.Server/EasyFinance.Server.csproj EasyFinance.Server/
COPY EasyFinance.Application/EasyFinance.Application.csproj EasyFinance.Application/
COPY EasyFinance.Domain/EasyFinance.Domain.csproj EasyFinance.Domain/
COPY EasyFinance.Infrastructure/EasyFinance.Infrastructure.csproj EasyFinance.Infrastructure/
COPY EasyFinance.Persistence/EasyFinance.Persistence.csproj EasyFinance.Persistence/

# The private fpssoftware.* packages live on the Gitea feed, and nuget.config declares its
# credentials as %GITEA_NUGET_USERNAME% / %GITEA_NUGET_TOKEN%. NuGet refuses to build a
# credential from an empty value, so a token is required. Both ways of supplying it are
# accepted, so this file serves CI (build args) and local runs (a BuildKit secret):
#   docker build --secret id=gitea_nuget_token,src=<file-with-token> ...
RUN --mount=type=secret,id=gitea_nuget_token,required=false \
    set -eu; \
    TOKEN="$(cat /run/secrets/gitea_nuget_token 2>/dev/null || echo "${GITEA_NUGET_TOKEN:-}")"; \
    if [ -z "${TOKEN}" ]; then \
      echo "The private Gitea NuGet feed needs a token for fpssoftware.chassis." >&2; \
      echo "Set GITEA_NUGET_TOKEN (and GITEA_NUGET_USERNAME) in your environment or .env," >&2; \
      echo "or build with --secret id=gitea_nuget_token,src=<file>." >&2; \
      exit 1; \
    fi; \
    GITEA_NUGET_TOKEN="${TOKEN}" dotnet restore EasyFinance.Server/EasyFinance.Server.csproj -r "$RUNTIME_ID"

COPY EasyFinance.Application/ EasyFinance.Application/
COPY EasyFinance.Domain/ EasyFinance.Domain/
COPY EasyFinance.Infrastructure/ EasyFinance.Infrastructure/
COPY EasyFinance.Persistence/ EasyFinance.Persistence/
COPY EasyFinance.Server/ EasyFinance.Server/

# Release, like the published image: Development is the environment the stack runs in, not
# a debug build. Publishing Debug here would put a different binary in front of you.
#
# DEV-ONLY, and it is not cosmetic: GenericRepository.Insert only tracks the entity it is given
# `#if DEBUG`, and a Release build makes every Insert a no-op. The seeder no longer relies on
# that (it adds its fixture graph to the change tracker itself), so this is a belt rather than
# the mechanism - but a fixture that still went through Insert would be silently skipped.
RUN dotnet publish EasyFinance.Server/EasyFinance.Server.csproj \
    -c Release \
    -p:DefineConstants=DEBUG \
    -r "$RUNTIME_ID" \
    --self-contained false \
    --no-restore

# ── Stage: runtime ─────────────────────────────────────────────────────────────────────
# The same runtime as the release image. The `-extra` tag is what carries ICU and the
# time-zone database; the Development stack needs them at least as much, because the fixtures
# and every "today" are computed in the developer's zone.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine-extra AS runtime
WORKDIR /app

# libgssapi_krb5.so.2 comes from krb5-libs. Nothing here authenticates with Kerberos, but
# .NET's managed GSSAPI backend (System.Net.Security) probes for that library while it builds
# its authentication packages, and on Alpine the probe fails on every start with:
#
#   Cannot load library libgssapi_krb5.so.2
#   Error loading shared library libgssapi_krb5.so.2: No such file or directory
#
# The failure is caught and harmless, which is exactly why it is worth removing: two
# error-looking lines at start-up train whoever reads the logs to ignore stderr. Only the
# library is installed (krb5-libs rather than the full krb5 tooling), and the release image
# installs it for the same reason.
RUN apk add --no-cache krb5-libs

COPY --from=client /src/easyfinance.client/dist/easyfinance.client/browser/ /app/wwwroot/
COPY --from=api /src/EasyFinance.Server/bin/Release/net10.0/linux-x64/publish/ /app/

# Attachments live in the stack's MinIO service, not in this container, so there is no
# persistent path here and nothing to mount.
RUN mkdir -p /app/tmp \
    && chown -R "$APP_UID" /app /app/tmp

# DEV-ONLY. Two listen ports of the one process, both published by the compose file:
#
#   4200  the SPA origin, and the port `ng serve` and the end-to-end suite use, so the suite
#         needs no stack-specific URL;
#   7003  the API on its own, which is what `dotnet run` uses - the mobile setup points the
#         emulator at it, and `curl` reaches the endpoints through it.
#
# The SPA and /api share 4200, which is the origin the Angular client requires.
#
# Development, so the sample data is seeded and the app runs its Development pipeline. TZ is
# the developer's own zone: dates are derived from the clock, so the container's "today" has
# to be the browser's.
ENV ASPNETCORE_ENVIRONMENT=Development \
    DOTNET_ENVIRONMENT=Development \
    ASPNETCORE_URLS=http://+:4200;http://+:7003 \
    TMPDIR=/app/tmp \
    TZ=Europe/Vienna

USER $APP_UID

EXPOSE 4200 7003

# The SPA shell and the API, on the ports this image publishes. Compose repeats this because a
# compose `test` replaces the image's HEALTHCHECK rather than adding to it.
HEALTHCHECK --interval=10s --timeout=5s --start-period=180s --retries=30 \
    CMD ["/bin/sh", "-c", "wget -q -O /dev/null http://127.0.0.1:4200/ && wget -q -O /dev/null http://127.0.0.1:7003/api/health/live || exit 1"]

ENTRYPOINT ["dotnet", "EasyFinance.Server.dll"]

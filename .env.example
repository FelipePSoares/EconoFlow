# Credentials for docker-compose.dev.yml (the local development stack).
#
# Copy this file to `.env` (which is git-ignored) and fill in the token:
#
#   GITEA_NUGET_USERNAME=your-gitea-user
#   GITEA_NUGET_TOKEN=<token with read:package>
#
# Without it the image cannot be built: the private fpssoftware.* packages (notably
# fpssoftware.chassis) live on the Gitea package feed, and nuget.config declares that
# feed's credentials as environment variable references, so NuGet refuses to restore
# when the password is empty.
#
# Create the token at Gitea -> User settings -> Applications -> Generate new token,
# selecting the `read:package` scope.
GITEA_NUGET_USERNAME=
GITEA_NUGET_TOKEN=
